<DIV align=3D"center">&nbsp;</DIV>
<DIV align=3D"center"><STRONG><FONT size=3D"6">MODIFICA INFORMAZIONI CESP=
ITI</FONT></STRONG></DIV><DIV align=3D"left">
<TABLE border=3D"1" cellspacing=3D"1" width=3D"16%">
  <TR>
    <TD><STRONG><FONT size=3D"2">v. 1.0</FONT></STRONG></TD>
