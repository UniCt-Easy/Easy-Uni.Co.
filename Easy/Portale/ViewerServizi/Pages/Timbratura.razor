    private string msgTimbrature = "";
    private bool successTimbrature = true;
    private string conn = "";
    private string errorMsg = "";

    List<oradb> timbratureDb;

    private bool isLoading = false;

    private bool isDownloading = false;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        ParseQueryString();
    }

    private void OnLocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ParseQueryString();

        StateHasChanged();
    }

    private void ParseQueryString()
    {
        Uri uri = new Uri(Navigation.Uri);
        string settingsFile = $"AppServizioTimbratura{uri.Query.Replace("?", ".")}.config";
        conn = timbraturaSrv.DoInit(settingsFile);
    }

    public void resetErrorMsg()
    {
        errorMsg = "";
    }

    private async Task GetTimbr()
    {
        errorMsg = "";

        if (idReg == "")
        {
            errorMsg = "Inserire un idReg!";
            return;
        }

        int _idreg = 0;
        int.TryParse(idReg, out _idreg);            

        if (_idreg <= 0)
        {
            errorMsg = "Inserire un idReg valido!";
            return;
        }

        // Clear the current table data
        timbratureDb = null;
        
        isLoading = true;

        StateHasChanged();

        await Task.Delay(1);

        List<oraws> timbrature = await timbraturaSrv.DoGetTimbratureZucchetti(idReg);
        timbratureDb = await timbraturaSrv.GetTimb(idReg);

        foreach (oraws timbratura in timbrature)
        {
            if (timbratureDb.Any(w => w.data == timbratura.data))
                timbratureDb.FirstOrDefault(w => w.data == timbratura.data).valws = timbratura.valws;
            else
                timbratureDb.Add(new oradb() { data = timbratura.data, valws = timbratura.valws });
        }

        isLoading = false;

        StateHasChanged();
    }

