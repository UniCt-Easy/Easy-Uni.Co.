@page "/timbratura"

<PageTitle>Timbratura</PageTitle>

@using ServizioTimbratura
@inject NavigationManager Navigation
@inject ServizioTimbratura.Timbratura timbraturaSrv
@inject IJSRuntime JS

<h1>Timbrature</h1>
<p>Possiamo vedere le Timbrature presenti su Zucchetti</p>
<p>@conn</p>
<div class="row mb-2">
    <div class="col-1">idReg: </div>
    <div class="col-2"><input id="idreg" @bind=@idReg @onclick="() => resetErrorMsg()" /></div>
</div>
@if (errorMsg != "")
{
    <div class="row mb-2">
        <div class="col-3">
            <p class="alert alert-danger">@errorMsg</p>
        </div>
    </div>
}
<div class="row mb-2 mt-2">
    <div class="col-3">
        <button class="btn btn-primary" @onclick="GetTimbr">Leggi dati da Zucchetti</button>
    </div>
</div>
<hr />
@if (isLoading)
{
    <p>Loading data...</p>
}
else if (isDownloading)
{
    <p>Loading data...</p>
}
else
{
    @if (timbratureDb != null)
    {
        <div class="row">
            <div class="col-12">            
                <table id="timbrature" class="table">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Web Service</th>
                            <th>Database</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (timbratureDb.Any())
                        {
                            foreach (var timbraturaDb in timbratureDb.OrderBy(o => o.data))
                            {
                                <tr style="@(string.IsNullOrEmpty(timbraturaDb.valdb) ? "background-color:lightgreen" : (timbraturaDb.valws != timbraturaDb.valdb ? "background-color:orange" : ""))">
                                    <td>@(timbraturaDb.data.ToString("yyyy/MM/dd"))</td>
                                    <td>@(timbraturaDb.valws)</td>
                                    <td>@(timbraturaDb.valdb)</td>
                                    <td><label class="btn btn-danger" @onclick="() => RemoveTimbratura(timbraturaDb.id)">x</label></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" align="center">Nessuna Timbratura presente nel servizio</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (timbratureDb.Any())
        {
            <div class="row mb-5">
                <div class="col-12">
                    <button class="btn btn-primary" onclick="downloadCSV()">Download CSV</button>
                    @* <button class="btn btn-warning" @onclick="UpdateDbTimbrature">Aggiorna Database</button> *@
                </div>
            </div>      
        }
        <div class="row mb-5">
            <div class="col-12">
                @msgTimbrature
            </div>
        </div>
    }
}

@code {
